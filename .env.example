# PostgreSQL database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prism

# Auth.js (GitHub OAuth)
AUTH_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# Encryption (AES-256-GCM master key for credential vault)
ENCRYPTION_MASTER_KEY=

# GitHub authentication (for direct PR ingestion)
GITHUB_TOKEN=

# GitHub App integration (for webhook-driven PR analysis)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
NEXT_PUBLIC_APP_URL=

# Nemotron AI backend
NEMOTRON_BASE_URL=
NEMOTRON_MODEL=
NVIDIA_API_KEY=
# Must stay below the hosting function limit so PRism can emit a terminal error.
NEMOTRON_TIMEOUT_MS=240000

# Trigger.dev (background job worker)
TRIGGER_API_KEY=
TRIGGER_API_URL=

# Feature flags (optional; defaults shown)
FEATURE_NEW_JOB_FLOW=true
FEATURE_NEW_DASHBOARD=true
FEATURE_CREDENTIAL_MANAGEMENT=true
FEATURE_WEBHOOK_ANALYSIS=true
FEATURE_NEW_REPORT_VIEWER=true
